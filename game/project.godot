; Engine configuration file.
; First Fire Alpha 0.1
config_version=5

[application]
config/name="First Fire"
run/main_scene="res://main.tscn"

[autoload]
Game="*res://scripts/Game.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.075, 0.08, 1)
